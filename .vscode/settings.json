{
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.check.command": "check",
  "rust-analyzer.checkOnSave.allTargets": false,
  "rust-analyzer.cargo.allFeatures": true,
  "rust-analyzer.procMacro.enable": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "chat.tools.terminal.autoApprove": {
    "cargo fmt": true,
    "cargo test": true,
    "cargo clippy": true,
    "/^sh \\.github/skills/rust-validation/scripts/verify\\.sh$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^cargo fmt --all && sh \\.github/skills/rust-validation/scripts/verify\\.sh$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^sh \\.github/skills/rust-validation/scripts/verify\\.sh; echo \"EXIT_CODE: \\$\\?\"$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "cSpell.words": ["Enneagram"]
}
